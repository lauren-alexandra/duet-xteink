+bool logicalPathExists(const char *path) {
+  const std::string full = resolveStoragePath(path);
+  if (full.empty()) {
+    return false;
+  }
+  struct stat info;
+  return stat(full.c_str(), &info) == 0;
+}
+
+const char *resolveReadPath(const char *requestedPath,
+                            std::string &resolvedPath) {
+  if (!requestedPath || !*requestedPath ||
+      logicalPathExists(requestedPath)) {
+    return requestedPath;
+  }
+  const auto candidates =
+      DuetStorage::legacyReadCandidates(requestedPath);
+  for (size_t i = 0; i < candidates.count; ++i) {
+    if (logicalPathExists(candidates.paths[i].c_str())) {
+      resolvedPath = candidates.paths[i];
+      return resolvedPath.c_str();
+    }
+  }
+  return requestedPath;
+}
+
+bool importLegacyFileBeforeUpdate(const char *requestedPath) {
+  if (!requestedPath || !*requestedPath ||
+      logicalPathExists(requestedPath) ||
+      !DuetStorage::isCanonicalPath(requestedPath)) {
+    return true;
+  }
+
+  const auto candidates =
+      DuetStorage::legacyReadCandidates(requestedPath);
+  const char *sourcePath = nullptr;
+  for (size_t i = 0; i < candidates.count; ++i) {
+    if (logicalPathExists(candidates.paths[i].c_str())) {
+      sourcePath = candidates.paths[i].c_str();
+      break;
+    }
+  }
+  if (!sourcePath) {
+    return true;
+  }
+
+  const std::string source = resolveStoragePath(sourcePath);
+  const std::string destination = resolveStoragePath(requestedPath);
+  const std::string temporary = destination + ".duet-cow.tmp";
+  if (source.empty() || destination.empty() ||
+      !ensureParentDirectories(destination)) {
+    return false;
+  }
+
+  ::remove(temporary.c_str());
+  const int input = ::open(source.c_str(), O_RDONLY);
+  const int output =
+      ::open(temporary.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  if (input < 0 || output < 0) {
+    if (input >= 0) ::close(input);
+    if (output >= 0) ::close(output);
+    ::remove(temporary.c_str());
+    return false;
+  }
+
+  uint8_t buffer[512];
+  bool ok = true;
+  while (true) {
+    const ssize_t count = ::read(input, buffer, sizeof(buffer));
+    if (count == 0) break;
+    if (count < 0 || ::write(output, buffer, static_cast<size_t>(count)) !=
+                         count) {
+      ok = false;
+      break;
+    }
+  }
+  ::close(input);
+  if (ok) ok = fsync(output) == 0;
+  if (::close(output) != 0) ok = false;
+  if (ok) ok = ::rename(temporary.c_str(), destination.c_str()) == 0;
+  if (!ok) ::remove(temporary.c_str());
+  return ok;
+}
